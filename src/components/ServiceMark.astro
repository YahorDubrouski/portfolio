---
interface Props {
    name: 'sources' | 'target' | 'live' | 'rerun' | 'check' | 'archive' | 'plan' | 'boundary' | 'cloud' | 'risk' | 'order';
}

const { name } = Astro.props;
---
<svg class="h-6 w-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" aria-hidden="true">
    {
        name === 'sources' && (
            <>
                <ellipse cx="8" cy="7" rx="4" ry="2" />
                <path d="M4 7v4c0 1.1 1.8 2 4 2s4-.9 4-2V7" stroke-linecap="round" />
                <ellipse cx="16" cy="13" rx="4" ry="2" />
                <path d="M12 13v4c0 1.1 1.8 2 4 2s4-.9 4-2v-4" stroke-linecap="round" />
            </>
        )
    }
    {
        name === 'target' && (
            <>
                <ellipse cx="12" cy="6" rx="7" ry="2.5" />
                <path d="M5 6v6c0 1.4 3.1 2.5 7 2.5s7-1.1 7-2.5V6" stroke-linecap="round" />
                <path d="M5 12v6c0 1.4 3.1 2.5 7 2.5s7-1.1 7-2.5v-6" stroke-linecap="round" />
            </>
        )
    }
    {
        name === 'live' && (
            <>
                <path d="M4 12h4l2-5 4 10 2-5h4" stroke-linecap="round" stroke-linejoin="round" />
            </>
        )
    }
    {
        name === 'rerun' && (
            <>
                <path d="M20 12a8 8 0 1 1-2.3-5.7" stroke-linecap="round" />
                <path d="M20 4v5h-5" stroke-linecap="round" stroke-linejoin="round" />
            </>
        )
    }
    {
        name === 'check' && (
            <>
                <circle cx="12" cy="12" r="8" />
                <path d="m8.5 12.5 2.5 2.5 4.5-5" stroke-linecap="round" stroke-linejoin="round" />
            </>
        )
    }
    {
        name === 'archive' && (
            <>
                <path d="M4 7h16v12H4z" stroke-linejoin="round" />
                <path d="M4 7 6 4h12l2 3M10 12h4" stroke-linecap="round" stroke-linejoin="round" />
            </>
        )
    }
    {
        name === 'plan' && (
            <>
                <path d="M7 3h7l4 4v14H7z" stroke-linejoin="round" />
                <path d="M14 3v4h4M9 12h6M9 16h4" stroke-linecap="round" stroke-linejoin="round" />
            </>
        )
    }
    {
        name === 'boundary' && (
            <>
                <rect x="3" y="6" width="7" height="12" rx="1" />
                <rect x="14" y="6" width="7" height="12" rx="1" />
            </>
        )
    }
    {
        name === 'cloud' && (
            <path d="M7 18h10a4 4 0 0 0 .4-8 5 5 0 0 0-9.6-1.5A3.5 3.5 0 0 0 7 18z" stroke-linejoin="round" />
        )
    }
    {
        name === 'risk' && (
            <>
                <path d="M12 4 3 19h18L12 4z" stroke-linejoin="round" />
                <path d="M12 10v4" stroke-linecap="round" />
                <path d="M12 16.5h.01" stroke-linecap="round" />
            </>
        )
    }
    {
        name === 'order' && (
            <>
                <path d="M9 7h10M9 12h10M9 17h10" stroke-linecap="round" />
                <circle cx="5.5" cy="7" r="1" fill="currentColor" stroke="none" />
                <circle cx="5.5" cy="12" r="1" fill="currentColor" stroke="none" />
                <circle cx="5.5" cy="17" r="1" fill="currentColor" stroke="none" />
            </>
        )
    }
</svg>
