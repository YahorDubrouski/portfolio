---
import HomeSectionHeader from './HomeSectionHeader.astro';

export interface PrincipleItem {
    title: string;
    body: string;
}

interface Props {
    title: string;
    subtitle?: string;
    principles: PrincipleItem[];
    linkHref?: string;
    linkLabel?: string;
    sequence?: boolean;
}

const { title, subtitle, principles, linkHref, linkLabel, sequence = false } = Astro.props;
---
<section class="border-b border-border bg-surface-muted py-16">
    <div class="mx-auto max-w-6xl px-4">
        <HomeSectionHeader title={title} subtitle={subtitle} linkHref={linkHref} linkLabel={linkLabel} />
        <ol class:list={[sequence ? 'flex flex-col lg:flex-row lg:items-stretch' : 'grid gap-5 sm:grid-cols-2']}>
            {
                principles.map((principle, index) => (
                    <>
                        {sequence && index > 0 && (
                            <li class="flex justify-center py-1 text-accent lg:shrink-0 lg:items-center lg:px-2 lg:py-0" aria-hidden="true">
                                <svg class="h-6 w-6 rotate-90 lg:rotate-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                    <path d="M5 12h14M13 6l6 6-6 6" stroke-linecap="round" stroke-linejoin="round" />
                                </svg>
                            </li>
                        )}
                        <li class="card-interactive flex-1 border-l-4 border-l-accent">
                            <p class="text-xs font-semibold tabular-nums tracking-widest text-accent">
                                {String(index + 1).padStart(2, '0')}
                            </p>
                            <h3 class="mt-2 font-serif text-lg font-semibold text-heading">{principle.title}</h3>
                            <p class="mt-2 text-sm leading-relaxed text-body">{principle.body}</p>
                        </li>
                    </>
                ))
            }
        </ol>
    </div>
</section>
