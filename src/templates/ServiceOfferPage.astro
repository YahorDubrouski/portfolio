---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
import CTAButton from '../components/CTAButton.astro';
import HomeSectionHeader from '../components/HomeSectionHeader.astro';
import WorkingPrinciples from '../components/WorkingPrinciples.astro';
import HomeClosingCta from '../components/HomeClosingCta.astro';
import ServiceMark from '../components/ServiceMark.astro';
import { getPageTitle } from '../i18n/translations/site';
import type { Locale } from '../i18n/locales';
import type { ServiceOffer } from '../data/services/types';
import { getCanonicalUrl, getSiteOrigin } from '../data/seo';

interface Props {
    locale: Locale;
    offer: ServiceOffer;
}

const { locale, offer } = Astro.props;
const pageTitle = getPageTitle(locale, offer.title);
const showArrow = offer.flow.length === 2;
const siteOrigin = getSiteOrigin();
const pageUrl = getCanonicalUrl(Astro.url.pathname, siteOrigin);
const portrait = '/images/yahor-dubrouski.png';
const portraitUrl = siteOrigin ? new URL(portrait, siteOrigin).href : undefined;

const serviceJsonLd: Record<string, unknown> = {
    '@context': 'https://schema.org',
    '@type': 'Service',
    name: offer.title,
    description: offer.description,
    serviceType: offer.serviceType,
    provider: {
        '@type': 'Person',
        name: 'Yahor Dubrouski',
        ...(siteOrigin ? { url: siteOrigin } : {}),
        ...(portraitUrl ? { image: portraitUrl } : {}),
    },
    areaServed: {
        '@type': 'Place',
        name: 'Worldwide',
    },
    offers: {
        '@type': 'AggregateOffer',
        priceCurrency: 'USD',
        lowPrice: offer.priceMin,
        highPrice: offer.priceMax,
        offerCount: 1,
        availability: 'https://schema.org/InStock',
        ...(pageUrl ? { url: pageUrl } : {}),
    },
    ...(pageUrl ? { url: pageUrl, '@id': `${pageUrl}#service` } : {}),
    ...(portraitUrl ? { image: portraitUrl } : {}),
};

const breadcrumbJsonLd: Record<string, unknown> | undefined =
    pageUrl && siteOrigin
        ? {
              '@context': 'https://schema.org',
              '@type': 'BreadcrumbList',
              itemListElement: [
                  {
                      '@type': 'ListItem',
                      position: 1,
                      name: 'Home',
                      item: new URL('/', siteOrigin).href,
                  },
                  {
                      '@type': 'ListItem',
                      position: 2,
                      name: offer.title,
                      item: pageUrl,
                  },
              ],
          }
        : undefined;

const jsonLd = breadcrumbJsonLd ? [serviceJsonLd, breadcrumbJsonLd] : serviceJsonLd;
---

<BaseLayout
    title={pageTitle}
    description={offer.description}
    locale={locale}
    jsonLd={jsonLd}
    image={portrait}
    imageAlt="Yahor Dubrouski"
>
    <Hero
        identityLine={offer.identityLine}
        headline={offer.headline}
        proofBadges={offer.proof.map((label) => ({ label }))}
        proofNote={offer.proofNote}
        photoSrc="/images/yahor-dubrouski.png"
        photoAlt="Yahor Dubrouski"
    >
        <div slot="actions">
            <p class="max-w-xl text-base leading-relaxed text-body">{offer.lede}</p>
            <div class="mt-8">
                <CTAButton href={offer.telegramHref} label={offer.ctaLabel} />
            </div>
        </div>
    </Hero>

    <section class="border-b border-border bg-surface py-16" aria-label={offer.flowTitle ?? offer.flowAria}>
        <div class="mx-auto max-w-6xl px-4">
            {offer.flowTitle && <HomeSectionHeader title={offer.flowTitle} />}
            <ol
                class:list={[
                    'gap-4',
                    showArrow
                        ? 'flex flex-col items-stretch sm:flex-row sm:items-center'
                        : offer.flow.length > 3
                          ? 'grid sm:grid-cols-2'
                          : 'grid sm:grid-cols-3',
                ]}
            >
                {
                    offer.flow.map((item, index) => (
                        <>
                            {showArrow && index === 1 && (
                                <li class="flex justify-center text-accent sm:shrink-0" aria-hidden="true">
                                    <svg class="h-6 w-6 rotate-90 sm:rotate-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                        <path d="M5 12h14M13 6l6 6-6 6" stroke-linecap="round" stroke-linejoin="round" />
                                    </svg>
                                </li>
                            )}
                            <li
                                class:list={[
                                    'card flex flex-1 items-start gap-4',
                                    item.accent && 'border-l-4 border-l-accent',
                                ]}
                            >
                                <span class="flex h-12 w-12 shrink-0 items-center justify-center rounded-md bg-accent-muted text-accent">
                                    <ServiceMark name={item.icon} />
                                </span>
                                <span>
                                    <span class="block text-xs font-semibold tracking-widest text-accent">{item.kicker}</span>
                                    <span class="mt-1 block font-serif text-lg font-semibold text-heading">{item.title}</span>
                                    {item.body && <span class="mt-1 block text-sm leading-relaxed text-body">{item.body}</span>}
                                </span>
                            </li>
                        </>
                    ))
                }
            </ol>
        </div>
    </section>

    <section class="border-b border-border bg-surface py-16">
        <div class="mx-auto max-w-6xl px-4">
            <HomeSectionHeader title={offer.getsTitle} />
            <ul class:list={['grid gap-5', offer.gets.length === 3 ? 'lg:grid-cols-3' : 'sm:grid-cols-2']}>
                {
                    offer.gets.map((item) => (
                        <li class="card">
                            <span class="flex h-10 w-10 items-center justify-center rounded-md bg-accent-muted text-accent">
                                <ServiceMark name={item.icon} />
                            </span>
                            <h3 class="mt-4 font-serif text-lg font-semibold text-heading">{item.title}</h3>
                            <p class="mt-2 text-sm leading-relaxed text-body">{item.body}</p>
                        </li>
                    ))
                }
            </ul>
        </div>
    </section>

    <WorkingPrinciples
        title={offer.stepsTitle}
        subtitle={offer.stepsSubtitle}
        principles={[...offer.steps]}
        sequence={offer.stepsSequence === true}
    />

    <section class="border-b border-border bg-surface py-16">
        <div class="mx-auto max-w-6xl px-4">
            <div class="max-w-2xl">
                <h2 class="text-2xl font-bold text-heading">{offer.fitTitle}</h2>
                <ul class="mt-4 space-y-3">
                    {
                        offer.fit.map((item) => (
                            <li class="flex gap-3 text-sm leading-relaxed text-body">
                                <span class="mt-0.5 shrink-0 text-accent" aria-hidden="true">
                                    <ServiceMark name="check" />
                                </span>
                                <span>{item}</span>
                            </li>
                        ))
                    }
                </ul>
            </div>
            <div class="card mt-10 max-w-2xl">
                <h2 class="text-2xl font-bold text-heading">{offer.priceTitle}</h2>
                <p class="mt-3 font-serif text-4xl font-semibold tracking-tight text-heading">{offer.priceAmount}</p>
                <p class="mt-3 text-base leading-relaxed text-body">{offer.priceBody}</p>
            </div>
        </div>
    </section>

    <HomeClosingCta
        title={offer.closingTitle}
        body={offer.closingBody}
        telegramHref={offer.telegramHref}
        telegramLabel={offer.ctaLabel}
    />
</BaseLayout>
